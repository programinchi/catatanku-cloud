rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null
          && request.auth.uid == userId;
    }

    function isValidNote() {
      let note = request.resource.data;

      return note.keys().hasAll([
          'title',
          'content',
          'createdAt',
          'updatedAt',
          'isPinned',
          'tags'
        ])
        && note.title is string
        && note.title.size() > 0
        && note.title.size() <= 200
        && note.content is string
        && note.createdAt is int
        && note.updatedAt is int
        && note.isPinned is bool
        && note.tags is list;
    }

    function isValidProfile() {
      let profile = request.resource.data;

      return profile.keys().hasOnly([
          'photoUrl',
          'photoUpdatedAt'
        ])
        && profile.keys().hasAll([
          'photoUrl',
          'photoUpdatedAt'
        ])
        && profile.photoUrl is string
        && profile.photoUrl.size() > 0
        && profile.photoUrl.size() <= 2048
        && profile.photoUrl.matches('https?://.*')
        && profile.photoUpdatedAt is int;
    }

    match /users/{userId} {

      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
          && isValidProfile();
    }

    match /users/{userId}/notes/{noteId} {

      allow read, delete: if isOwner(userId);

      allow create, update: if isOwner(userId)
          && isValidNote();
    }
  }
}